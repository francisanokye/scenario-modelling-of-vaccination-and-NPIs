df_mult <- policy_df %>%
transmute(
date,
m_als_obs    = make_smooth_series(date, als,    map = m_als,    tau = tau_days),
m_school_obs = make_smooth_series(date, school, map = m_school, tau = tau_days)
)
# constant als per column (order matches als facets)
cf_tbl <- tibble(
scenario   = als_fac,
mALS_const = c(unname(m_als["ALS2"]), unname(m_als["ALS4"]), 1.0)
)
als_ratio <- df_mult %>%
tidyr::crossing(cf_tbl) %>%
mutate(beta_ratio = pmax(mALS_const / pmax(m_als_obs, 1e-12), 0)) %>%
transmute(date, als_scen = factor(scenario, levels = levels(als_fac)), beta_ratio)
# ---- simulation helpers ---------------------------------------------------
set_vax <- function(cf, scale) {
cf$default$double_vac_values  <- scale * cf$default$double_vac_values_base
cf$default$booster_vac_values <- scale * cf$default$booster_vac_values_base
cf
}
simulate_series <- function(scale) {
cf <- spec_fixed %>% set_vax(scale)
cf %>%
mp_simulator(time_steps, outputs = "inc") %>%
mp_trajectory() %>%
filter(matrix == "inc") %>%
mutate(date = date0 + (time - offset0)) %>%
filter(date >= date0, date <= date_end) %>%
transmute(date, inc = value)
}
# ---- baseline and counterfactuals ----------------------------------------
# baseline (observed @ 100%), kept as a simple series by date
baseline <- simulate_series(1.00) %>% mutate(series = "observed")
# counterfactual grid: for each vax level, transform by constant als columns
grid_sims <- map_dfr(levels(vax_fac), function(vlbl) {
scl   <- vax_scales[[vlbl]]
basev <- simulate_series(scl)
map_dfr(levels(als_fac), function(ac) {
basev %>%
left_join(filter(als_ratio, als_scen == ac), by = "date") %>%
mutate(
inc      = pmax(inc * beta_ratio, 0),
vax      = factor(vlbl, levels = levels(vax_fac)),
als_scen = factor(ac,   levels = levels(als_fac)),
series   = "counterfactual"
) %>%
select(date, inc, vax, als_scen, series)
})
})
# ---- clone grid_sims, swap inc with baseline by date, relabel to 'observed' ---
observed_from_grid <- grid_sims %>%
select(date, vax, als_scen) %>%                # keep exact panel structure
left_join(baseline %>% select(date, inc), by = "date") %>%  # inject baseline values
mutate(series = "observed") %>%
relocate(series, .after = inc)
# ---- bind the two dataframes for plotting --------------------------------
plot_df <- bind_rows(
grid_sims,           # series == 'counterfactual' (blue)
observed_from_grid   # series == 'observed'       (red)
)
# ---- build combined per-panel titles and ensure strict 3x3 ordering -------
panel_levels <- as.vector(outer(levels(vax_fac), levels(als_fac),
FUN = function(v, a) paste0("vaccination ", v, " || ", a)))
plot_df2 <- plot_df %>%
mutate(panel_title = paste0("vaccination ", vax, " || ", als_scen),
panel_title = factor(panel_title, levels = panel_levels))
# compute cumulative infections, peak infections, and peak date by scenario
# --- build per-panel annotations from the counterfactual series only ---
# values: cumulative infections, peak infections, full peak date
cf_ann <- plot_df2 %>%
dplyr::filter(series == "counterfactual") %>%
dplyr::group_by(vax, als_scen) %>%
dplyr::summarize(
cumulative_infections = sum(inc, na.rm = TRUE),
peak_infections       = max(inc, na.rm = TRUE),
peak_date             = date[which.max(inc)],
.groups = "drop"
) %>%
dplyr::mutate(
panel_title = factor(paste0("vaccination ", vax, " || ", als_scen),
levels = panel_levels),
ann_lab = paste0(
"Peak date: ", format(peak_date, "%B %d, %Y"), "\n",
"Peak cases: ", scales::comma(round(peak_infections)), "\n",
"Total cases: ", scales::comma(round(cumulative_infections))
)
)
# choose a consistent, readable label position inside each facet
ann_pos <- plot_df2 %>%
dplyr::group_by(vax, als_scen) %>%
dplyr::summarize(.groups = "drop") %>%
dplyr::mutate(
panel_title = factor(paste0("vaccination ", vax, " || ", als_scen),levels = panel_levels),
xpos = date0 + 5, ypos = 6100
)
ann_df <- dplyr::left_join(cf_ann, ann_pos,by = c("vax","als_scen","panel_title"))
# ---- 3x3 figure with axes on every panel and clear per-panel titles -------
p_3x3 <- ggplot() +
geom_line(
data = dplyr::filter(plot_df2, series == "counterfactual"),
aes(x = date, y = inc, group = 1),
color = "blue", linewidth = 1.5, alpha = 1
) +
geom_line(
data = dplyr::filter(plot_df2, series == "observed"),
aes(x = date, y = inc, group = 1), color = "red", linewidth = 1.5, alpha = 1
) +
geom_text(data = ann_df,aes(x = xpos, y = ypos, label = ann_lab),
inherit.aes = FALSE,size = 5, lineheight = 0.98,hjust = 0, vjust = 1)+
ggh4x::facet_wrap2(~ panel_title, nrow = 3, ncol = 3, axes = "all") +  # axes on every panel
labs(title = "Counterfactual scenario (blue) vs Estimated Infections (red)",
y = "Estimated infections") +
scale_x_date(limits = c(date0, date_end), expand = c(0, 0),
date_breaks = "2 weeks", date_labels = "%b %d") +
theme_clean()+
theme(
axis.text.x = element_text(size = 16, angle = 45, hjust = 1),
axis.title.x = element_blank(),
axis.text.y = element_text(size = 16),
axis.title.y = element_text(size = 18),
plot.title = element_text(size = 22, hjust = 0.5, face = "plain"),
strip.text   = element_text(size = 20, face = "plain"),
legend.position = "bottom",
panel.spacing   = unit(0.7, "lines"),
plot.background = element_blank()
)
print(p_3x3)
png("../figures/observed_vs_counterfactuals.png",width = 5200, height = 4200, res = 300, bg = "white", type = "cairo")
print(p_3x3)
p_3x3
# ============================================================
# β(t) deconvolution with smooth policy multipliers (No-ALS baseline)
# Outputs: multipliers, β0_hat vs β_hat, validation, heatmap, vax-flow scenarios
# ============================================================
suppressPackageStartupMessages({
library(tidyverse); library(lubridate);
library(zoo); library(dplyr);
library(tidyr); library(stringr);
library(ggplot2); library(viridis);
library(scales); library(ggthemes);
library(patchwork)
})
set.seed(2025)
# ------------------------------------------------------------------
data_flow <- read.csv("~/Documents/MUN/PAPER2/scenario-modelling-of-vaccination-and-NPIs/data/doubboosterbeta.csv")
stopifnot(exists("data_flow"))
stopifnot(all(c("beta","double","booster") %in% names(data_flow)))
beta_vec       <- as.numeric(data_flow$beta)
vac2_base_raw  <- as.numeric(data_flow$double)
vac3_base_raw  <- as.numeric(data_flow$booster)
N_pop <- 510550
# ---------- 1) study window ----------
start_date <- as.Date("2021-12-15")
beta_true_df <- tibble(
date = seq(start_date, by = "day", length.out = length(beta_vec)),
beta_hat = pmax(beta_vec, 1e-8)
)
end_date <- max(beta_true_df$date)
base_df  <- tibble(date = seq(start_date, end_date, by = "day"),t    = as.numeric(date - start_date) + 1)
# ---------- 2) policy calendar (NL) ----------
in_int <- function(d, a, b) d >= as.Date(a) & d <= as.Date(b)
policy_df <- base_df %>%
mutate(
ALS = case_when(
in_int(date,"2021-12-15","2021-12-24") ~ "ALS2",
in_int(date,"2021-12-25","2022-01-03") ~ "ALS3",
in_int(date,"2022-01-04","2022-02-07") ~ "ALS4",
in_int(date,"2022-02-08","2022-03-14") ~ "ALS3",
in_int(date,"2022-03-15","2022-05-22") ~ "NoALS",
TRUE ~ "ALS2"
),
school = case_when(
in_int(date,"2021-12-20","2022-01-25") ~ "closed",
TRUE ~ "open"
)
)
# merge β̂(t)-
df <- policy_df %>% left_join(beta_true_df, by = "date")
stopifnot(!any(is.na(df$beta_hat)))
# multipliers re-baselined to No-ALS = 1 ----------
R_ALS4   <- 1.52
R_ALS3   <- 2.12
R_NoALS  <- 2.32
R_open   <- 2.03
R_closed <- 1.44
R_ALS2 <- sqrt(R_ALS3 * R_NoALS)
# ALS multipliers relative to No-ALS baseline (=1)
m_als <- c(
"ALS4"  = R_ALS4  / R_NoALS, #R_ALS2,  # <1
"ALS3"  = R_ALS3  / R_NoALS, #R_ALS2,  # ≤1
"ALS2"  = R_ALS2  / R_NoALS, # R_ALS2,  # ≤1
"NoALS" = 1.00
)
# school multipliers (closed < 1)
m_school <- c(open = 1.00, closed = R_closed / R_open)
# smooth time-varying multipliers (C¹ at change dates) ----------
smooth_step <- function(t, t0, tau = 1.5) plogis((as.numeric(t - t0))/tau)  # tau in days
# build smooth series for categorical timeline using chained logistic blends
make_smooth_series <- function(date, lev, map, tau = 2.0) {
lev <- as.character(lev)
seg_idx    <- c(1L, which(lev[-1L] != lev[-length(lev)]) + 1L)
seg_dates  <- date[seg_idx]
seg_levels <- lev[seg_idx]
m <- rep(unname(map[seg_levels[1L]]), length(date))
if (length(seg_idx) >= 2L) {
for (j in 2:length(seg_idx)) {
t0 <- seg_dates[j]
m_target <- unname(map[seg_levels[j]])
s <- smooth_step(date, t0, tau)
m <- m*(1 - s) + m_target*s
}
}
m
}
tau_days <- 2.0  # days until policy takes effect
z = 1.0
df_est <- df %>%
mutate(
m_ALS_hat    = make_smooth_series(date, ALS,    map = m_als,    tau = tau_days),
m_school_hat = make_smooth_series(date, school, map = m_school, tau = tau_days),
m_obs_hat    = m_ALS_hat * m_school_hat,
beta0_hat    = beta_hat / pmax(m_obs_hat, 1e-8),   # ⇒ β0 ≥ β̂ under any ALS/school-closed
beta_recon   = beta0_hat * m_obs_hat,
beta_hat_sd = sd(beta_hat),
beta0_hat_sd =  sd(beta0_hat),
beta_hat_l  = beta_hat  - z * beta_hat_sd,
beta_hat_u  = beta_hat  + z * beta_hat_sd,
beta0_hat_l = beta0_hat - z * beta0_hat_sd,
beta0_hat_u = beta0_hat + z * beta0_hat_sd
)
# markers for plotting
als_change_dates <- df %>%
mutate(chg = ALS != lag(ALS)) %>% filter(!is.na(chg) & chg) %>% distinct(date)
school_change_dates <- df %>%
mutate(chg = school != lag(school)) %>% filter(!is.na(chg) & chg) %>% distinct(date)
# methods figure: (a) multipliers, (b) β0 vs β̂
mult_long <- df_est |>
select(date, `ALS`=m_ALS_hat, `School`=m_school_hat, `Combined`=m_obs_hat) |>
pivot_longer(-date, names_to = "series", values_to = "value")
pB_mult <- ggplot(mult_long, aes(date, value, color = series)) +
geom_line(linewidth = 0.8, alpha = 1.0) +
scale_color_manual(values = c("ALS"="#D01125","School"="#40B0A6","Combined"="#E69F00")) +
labs(title="Policy effect multipliers", y="Multiplier", x=NULL, color=NULL) +
scale_x_date(date_breaks="2 weeks", date_labels="%b %d", expand = c(0,0)) +
geom_vline(data=als_change_dates, aes(xintercept=as.numeric(date)), linetype="dashed", linewidth = 1) +
geom_vline(data=school_change_dates, aes(xintercept=as.numeric(date)), linetype="dotdash", linewidth = 1, color="brown") +
theme_clean() +
theme(
axis.text.x = element_text(size = 12, angle = 0, hjust = 0.85),
axis.title.x = element_text(size = 12),
axis.text.y = element_text(size = 12),
axis.title.y = element_text(size = 12, color = "black"),
plot.title = element_text(size = 12, color = "black", hjust = 0.5, face = "plain"),
strip.text = element_text(size = 12, color = "black"),
legend.title = element_blank(),
legend.text = element_text(size = 10),
legend.background = element_rect(color = NA),
legend.margin = margin(0, 0, 0, 0),
plot.background = element_blank(),
legend.position = c(0.8, 0.2)
)
p_beta_overlay <- ggplot(df_est, aes(date)) +
# map to category keys that exist in scale_fill_manual()
geom_ribbon(aes(ymin = beta_hat_l,  ymax = beta_hat_u,  fill = "estimated"),       alpha = 0.25, color = NA) +
geom_ribbon(aes(ymin = beta0_hat_l, ymax = beta0_hat_u, fill = "policy-neutral"),  alpha = 0.25, color = NA) +
geom_line(aes(y = beta_hat,  color = "estimated (β̂(t))"),      linewidth = 2) +
geom_line(aes(y = beta0_hat, color = "policy-neutral β₀(t)"),   linewidth = 1) +
labs(title = "Estimated transmission rate vs Policy-neutral transmission",
x = NULL, y = "Transmission rate") +
scale_color_manual(values = c("estimated (β̂(t))" = "red",
"policy-neutral β₀(t)" = "blue"),
name = NULL) +
scale_fill_manual(values = c("estimated" = "red",
"policy-neutral" = "blue"),
guide = "none") +
scale_x_date(date_breaks = "2 weeks", date_labels = "%b %d", expand = c(0, 0)) +
geom_vline(data = als_change_dates,    aes(xintercept = date),linetype = "dashed",linewidth = 1) +
geom_vline(data = school_change_dates, aes(xintercept = date),linetype = "dotdash",linewidth = 1, color = "brown") +
theme_clean() +
theme(
axis.text.x  = element_text(size = 12, angle = 0, hjust = 0.85),
axis.ticks.x = element_blank(),
axis.title.x = element_text(size = 12),
axis.text.y  = element_text(size = 12),
axis.title.y = element_text(size = 12, color = "black"),
plot.title   = element_text(size = 12, color = "black", hjust = 0.5, face = "plain"),
strip.text   = element_text(size = 12, color = "black"),
legend.title = element_blank(),
legend.text  = element_text(size = 11),
legend.background = element_rect(color = NA),
legend.margin     = margin(0, 0, 0, 0),
plot.background   = element_blank(),
legend.position   = c(0.7, 0.2),
plot.margin  = margin(0, 6, -10, 6)
)
