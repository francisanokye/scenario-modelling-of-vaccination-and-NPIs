# vaccination daily flows (observed + scaled scenarios)
align_len <- function(x, n, fill = 0) {
if (length(x) == n) return(x)
if (length(x) > n)  { message(sprintf("truncating %d extra elements", length(x) - n)); return(x[seq_len(n)]) }
if (length(x) < n)  { message(sprintf("padding %d missing elements with %s", n - length(x), as.character(fill)));
return(c(x, rep(fill, n - length(x)))) }
}
n_days    <- nrow(df)
vac3_base <- align_len(vac3_base_raw, n_days, fill = 0)
vac2_base <- align_len(vac2_base_raw, n_days, fill = 0)
