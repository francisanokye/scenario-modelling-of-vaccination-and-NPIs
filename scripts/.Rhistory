"v3: 25% rates"  = "dashed")) +
scale_y_continuous(labels = label_number(big.mark = ",")) +
labs(title = "Vaccination-rate daily flows (observed and scaled rates)",
x = NULL, y = "vaccinated individuals") +
scale_x_date(date_breaks = "2 weeks", date_labels = "%b %d", expand = c(0,0)) +
