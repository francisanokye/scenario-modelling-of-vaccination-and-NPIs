library(shellpipes); library(macpan2)
library(ggh4x); library(RColorBrewer);
library(scales)
})
# ---- setup ---------------------------------------------------------------
set.seed(2025)
# try to load shellpipes environments; ok if absent
try(loadEnvironments(), silent = TRUE)
# robust .rds reader that tries multiple candidate paths
readRDS_any <- function(candidates) {
for (p in candidates) if (file.exists(p)) return(readRDS(p))
stop(
"required .rds not found.\ntried:\n - ",
paste(normalizePath(candidates, mustWork = FALSE), collapse = "\n - "),
"\nworking dir: ", getwd(), call. = FALSE
)
}
# ---- config --------------------------------------------------------------
date0    <- as.Date("2021-12-15")
date_end <- as.Date("2022-05-22")
# facet levels: rows = vaccination %, cols = constant als scenario
vax_scales <- c("75%" = 0.75, "50%" = 0.50, "25%" = 0.25)
vax_levels <- names(vax_scales)
vax_fac    <- factor(vax_levels, levels = vax_levels)
als_cols <- c("als-2 throughout", "als-4 throughout", "no-als throughout")
als_fac  <- factor(als_cols, levels = als_cols)
